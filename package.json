{
  "name": "sportsos-next",
  "version": "0.1.0",
  "private": true,
  "description": "SportsOS Next monorepo for sports management, live scoring, overlays, streaming, and hardware integrations.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@sportsos/api",
    "dev:api": "npm run dev --workspace=@sportsos/api",
    "dev:dashboard": "npm run dev --workspace=@sportsos/dashboard",
    "build": "npm run build --workspace=@sportsos/core && npm run build --workspace=@sportsos/config && npm run build --workspace=@sportsos/api && npm run build --workspace=@sportsos/dashboard",
    "build:core": "npm run build --workspace=@sportsos/core",
    "build:api": "npm run build --workspace=@sportsos/api",
    "build:dashboard": "npm run build --workspace=@sportsos/dashboard",
    "typecheck": "npm run ci:prepare && npm run typecheck --workspaces --if-present",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "clean": "node scripts/clean.mjs",
    "ci:prepare": "npm run build --workspace=@sportsos/core && npm run build --workspace=@sportsos/config",
    "ci:verify": "npm run ci:prepare && npm run lint && npm run typecheck && npm run test && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:docker": "./scripts/test-e2e-docker.sh",
    "test:game-engine:stress": "./scripts/test-game-engine-stress.sh",
    "test:tournament-simulation": "./scripts/test-tournament-simulation.sh",
    "test:tournament-runner": "./scripts/test-tournament-runner.sh",
    "test:simulation-adapter": "./scripts/test-sportsos-simulation-adapter.sh",
    "test:simulation-provisioner": "./scripts/test-simulation-provisioner.sh",
    "test:simulation-qualification": "./scripts/test-simulation-qualification.sh",
    "test:e2e:game-day": "playwright test e2e/game-day-scorekeeper.spec.ts --project=chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "prettier": "3.9.6"
  }
}
