{
  "name": "@sportsos/api",
  "version": "0.3.5-roster-engine",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "qualify:schedule-concurrency": "node --input-type=module -e \"import('./dist/modules/games/schedule-concurrency-qualification.js').then(async m => { const r = await m.runScheduleConcurrencyQualification(); console.log(JSON.stringify(r, null, 2)); process.exit(r.passed ? 0 : 1); }).catch(e => { console.error(e); process.exit(1); })\""
  },
  "dependencies": {
    "@fastify/compress": "^9.1.0",
    "@fastify/cors": "10.1.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "10.2.2",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@sportsos/config": "*",
    "@sportsos/core": "*",
    "bcryptjs": "3.0.2",
    "fastify": "^5.10.0",
    "minio": "8.0.7",
    "mqtt": "5.15.2",
    "mysql2": "3.23.1",
    "redis": "5.9.0",
    "socket.io": "^4.8.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
